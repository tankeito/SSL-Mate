# ==========================================
# SSL-Mate (证书伴侣) Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
*.local

# Environment Variables & Secrets (Keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Local Database & Runtime Certificate Storage
data/*
!data/.gitkeep
data/*.json
data/certs/
data/keys/
data/archive/
data/logs/

# SSL Certificates & Private Keys (Prevent credential leaks)
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12

# Runtime & Debug Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary & Cache Files
.temp/
tmp/
temp/
.cache/
.eslintcache
.vite/
