# SSL-Mate Enterprise Configuration

PORT=8989
DATA_DIR=./data

# Security Keys (Leave empty to automatically generate and persist high-entropy 256-bit random keys in data/ directory)
JWT_SECRET=
MASTER_KEY=

# Engine Concurrency Settings
ACME_CONCURRENCY=3
MONITOR_CONCURRENCY=6

# Optional Default Admin Seeder (used only on first clean installation)
# DEFAULT_ADMIN_USER=admin
# DEFAULT_ADMIN_EMAIL=admin@sslmate.local
# DEFAULT_ADMIN_PASSWORD=Admin@SSL2026!
# DEFAULT_ACME_EMAIL=admin@sslmate.local

# AuthMate OIDC SSO Integration
AUTHMATE_ENABLED=true
AUTHMATE_ISSUER_URL=http://127.0.0.1:8787
AUTHMATE_CLIENT_ID=sslmate-app
AUTHMATE_CLIENT_SECRET=
AUTHMATE_REDIRECT_URI=http://localhost:5173/oauth/callback
